{
  "name": "@transformlit/graphql",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "graphql:codegen": "graphql-codegen --config codegen.ts",
    "build": "pnpm run clean && pnpm graphql:codegen && tsc -p tsconfig.json --incremental false",
    "typecheck": "pnpm graphql:codegen && tsc --noEmit -p tsconfig.json --incremental false",
    "test": "pnpm run build && node --test test/clean-consumer.spec.cjs test/turbo-contract.spec.cjs",
    "clean": "rm -rf src/__generated__ dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@graphql-codegen/typescript-react-apollo": "^4.4.2",
    "graphql": "^16.14.2",
    "typescript": "^6.0.3"
  }
}
