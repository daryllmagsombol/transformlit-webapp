environment                = "dev"
location                   = "southeastasia"
domain_name                = "dev.transformlit.com"
ghcr_owner                 = "transformlit"
container_api_min_replicas = 1
container_web_min_replicas = 0

postgres_sku       = "B_Standard_B1ms"
postgres_storage_mb = 32768

# Fill in your values:
subscription_id       = ""
postgres_admin_password = ""
jwt_secret            = ""
jwt_refresh_secret    = ""
google_client_id      = ""
google_client_secret  = ""

tags = {
  environment = "dev"
  project     = "transformlit"
  managed_by  = "terraform"
}
