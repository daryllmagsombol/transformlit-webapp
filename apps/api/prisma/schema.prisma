generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── User & Auth ────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MODERATOR
  MEMBER
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  emailNormalized String  @unique
  passwordHash   String?
  displayName    String
  avatarUrl      String?
  bio            String?
  role           UserRole @default(MEMBER)
  status         String   @default("active")
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  identities         Identity[]
  refreshTokens      RefreshToken[]
  friendshipsAsRequester Friendship[]  @relation("Requester")
  friendshipsAsAddressee Friendship[]  @relation("Addressee")
  groupMemberships   GroupMember[]
  groupPosts        GroupPost[]
  groupPostLikes    GroupPostLike[]
  groupPostComments GroupPostComment[]
  sentMessages       Message[]
  conversationMembers ConversationMember[]
  bookAccess         BookAccess[]
  bookProgress       BookProgress[]
  bookmarks          Bookmark[]
  highlights         Highlight[]
  operationReceipts  ReaderOperationReceipt[]
  readerTombstones   ReaderTombstone[]
  conflictCopies     ConflictCopy[]
  readingSessions    ReadingSession[]
  notifications      Notification[]     @relation("NotificationUser")
  notificationsCreated Notification[]   @relation("NotificationCreatedBy")
  announcementsPublished Announcement[] @relation("AnnouncementPublishedBy")
  announcementsCreated Announcement[]   @relation("AnnouncementCreatedBy")
  groupsCreated      Group[]            @relation("GroupCreatedBy")
  booksCreated       Book[]             @relation("BookCreatedBy")
  auditLogs         AuditLog[]
  activityEvents        ActivityEvent[]
  activityEventReceipts ActivityEventReceipt[]
  dailyActivityTypes    DailyActivityType[]
  dailyActivity         DailyActivity[]
  readingGoals          ReadingGoal[]
  streak                UserStreak?

  @@index([emailNormalized])
  @@index([role, status])
  @@map("users")
}

model Identity {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String
  providerId String
  email      String
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
  @@index([userId])
  @@map("identities")
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  familyId    String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, familyId])
  @@map("refresh_tokens")
}

// ── Groups ─────────────────────────────────────────────────────────────────

enum GroupCategory {
  BIBLICAL_STUDIES
  MODERN_FICTION
  HISTORICAL
  PHILOSOPHY
  YOUNG_ADULT
}

enum GroupVisibility {
  PUBLIC
  PRIVATE
}

enum GroupMemberRole {
  OWNER
  MODERATOR
  MEMBER
}

enum GroupMemberStatus {
  ACTIVE
  PENDING
  BANNED
}

model Group {
  id            String          @id @default(uuid())
  name          String
  slug          String          @unique
  description   String?
  visibility    GroupVisibility @default(PUBLIC)
  category      GroupCategory?
  coverImageUrl String?
  featured      Boolean         @default(false)
  createdById   String?
  createdBy     User?           @relation("GroupCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  members       GroupMember[]
  posts         GroupPost[]
  conversations Conversation[]

  @@index([visibility])
  @@index([category])
  @@index([featured])
  @@index([name])
  @@map("groups")
}

model GroupMember {
  id        String            @id @default(uuid())
  groupId   String
  group     Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      GroupMemberRole   @default(MEMBER)
  status    GroupMemberStatus @default(PENDING)
  joinedAt  DateTime          @default(now())
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId, status])
  @@map("group_members")
}

// ── Group Posts ─────────────────────────────────────────────────────────────

model GroupPost {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  imageKey  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  likes    GroupPostLike[]
  comments GroupPostComment[]

  @@index([groupId, createdAt])
  @@index([authorId])
  @@map("group_posts")
}

model GroupPostLike {
  id        String    @id @default(uuid())
  postId    String
  post      GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([postId, userId])
  @@map("group_post_likes")
}

model GroupPostComment {
  id        String    @id @default(uuid())
  postId    String
  post      GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([postId, createdAt])
  @@map("group_post_comments")
}

// ── Friends ─────────────────────────────────────────────────────────────────

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  requester   User             @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
  @@map("friendships")
}

// ── Chat ────────────────────────────────────────────────────────────────────

enum ConversationType {
  DIRECT
  GROUP
}

model Conversation {
  id        String           @id @default(uuid())
  type      ConversationType
  groupId   String?
  group     Group?           @relation(fields: [groupId], references: [id])
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  members  ConversationMember[]
  messages Message[]

  @@index([type])
  @@map("conversations")
}

model ConversationMember {
  id             String   @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  joinedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  editedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}

// ── Books ───────────────────────────────────────────────────────────────────

enum BookAccessLevel {
  FREE
  RESTRICTED
}

enum BookStatus {
  DRAFT
  PUBLISHED
  COMING_SOON
}

enum BookFormat {
  PDF
  EPUB
}

enum ConversionStatus {
  NOT_APPLICABLE
  PENDING
  PROCESSING
  READY
  FAILED
}

model Book {
  id            String          @id @default(uuid())
  title         String
  author        String?
  description   String?
  blobPath      String?
  coverUrl      String?
  price         Decimal?        @db.Decimal(10, 2)
  currency      String?         @default("USD")
  accessLevel   BookAccessLevel @default(FREE)
  status        BookStatus      @default(DRAFT)
  totalPages    Int?
  format           BookFormat?
  pageCount        Int?
  conversionStatus ConversionStatus @default(NOT_APPLICABLE)
  conversionError  String?
  contentVersion   Int              @default(1)
  createdById   String?
  createdBy     User?           @relation("BookCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  publishedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  access     BookAccess[]
  progress   BookProgress[]
  bookmarks  Bookmark[]
  highlights Highlight[]

  pages            BookPage[]
  tocEntries       BookTocEntry[]
  conversionJobs   BookConversionJob[]
  readingSessions  ReadingSession[]
  pageViews        PageView[]
  contentVersions  BookContentVersion[]
  conflictCopies   ConflictCopy[]

  @@index([status])
  @@index([title])
  @@map("books")
}

/**
 * Immutable published snapshot of a book at a specific `contentVersion`.
 * The `BookPage`/`BookTocEntry` tables remain the current-version projection;
 * these rows are append-only so a download can stay pinned to a version even
 * after a newer publication. `eligible` is only true once every page's frame
 * and text-layer bytes have been checksummed from actual stored assets — a
 * legacy row migrated without verifiable assets stays ineligible rather than
 * serving fabricated checksums or text.
 */
model BookContentVersion {
  id             String     @id @default(uuid())
  bookId         String
  book           Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  contentVersion Int
  title          String
  author         String?
  description    String?
  format         BookFormat?
  pageCount      Int
  eligible       Boolean    @default(false)
  verifiedAt     DateTime?
  publishedAt    DateTime   @default(now())
  createdAt      DateTime   @default(now())

  pages      BookContentVersionPage[]
  tocEntries BookContentVersionTocEntry[]

  @@unique([bookId, contentVersion])
  @@index([bookId, eligible, contentVersion(sort: Desc)])
  @@map("book_content_versions")
}

model BookContentVersionPage {
  id               String             @id @default(uuid())
  contentVersionId String
  contentVersion   BookContentVersion @relation(fields: [contentVersionId], references: [id], onDelete: Cascade)
  index            Int
  /** Server-private storage keys: never exposed through the download contract. */
  assetKey         String
  textKey          String?
  hasTextLayer     Boolean            @default(false)
  mimeType         String?
  width            Int?
  height           Int?
  charCount        Int?
  frameByteLength  Int?
  frameSha256      String?
  textByteLength   Int?
  textSha256       String?
  createdAt        DateTime           @default(now())

  @@unique([contentVersionId, index])
  @@map("book_content_version_pages")
}

model BookContentVersionTocEntry {
  id               String             @id @default(uuid())
  contentVersionId String
  contentVersion   BookContentVersion @relation(fields: [contentVersionId], references: [id], onDelete: Cascade)
  title            String
  page             Int
  depth            Int                @default(0)
  order            Int
  createdAt        DateTime           @default(now())

  @@index([contentVersionId, order])
  @@map("book_content_version_toc_entries")
}

model BookAccess {
  id        String   @id @default(uuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String?
  grantedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookId, userId])
  @@index([userId])
  @@map("book_access")
}

model BookProgress {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId      String
  book        Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  currentPage Int       @default(1)
  scrollY     Float?
  completedAt DateTime?
  /**
   * Revision of the authoritative progress row. Starts at 0 when absent (the
   * first versioned write sets it to 1) so a stale `baseRevision` is an explicit
   * conflict rather than a silent highest-page-wins overwrite.
   */
  revision    Int       @default(0)
  lastReadAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, bookId])
  @@index([bookId])
  @@map("book_progress")
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  page      Int
  label     String?
  color     String?
  anchor         Json?
  contentVersion Int?
  /** Stable client-generated identity; NULL for legacy rows of unknown provenance. */
  clientEntityId String?
  /** Per-entity revision, incremented on conflict-copy retarget. */
  revision       Int      @default(1)
  /** Soft-delete marker; a tombstone is retained so a delayed retry cannot resurrect. */
  deletedAt      DateTime?
  createdAt DateTime @default(now())

  @@unique([userId, clientEntityId])
  @@index([userId, bookId])
  @@map("bookmarks")
}

model Highlight {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  page      Int
  text      String
  note      String?
  color     String?
  anchor         Json?
  contentVersion Int?
  /** Stable client-generated identity; NULL for legacy rows of unknown provenance. */
  clientEntityId String?
  /** Per-entity revision, incremented on each successful conditional write. */
  revision       Int      @default(1)
  /** Soft-delete marker; tombstone retained so a delayed retry cannot resurrect. */
  deletedAt      DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, clientEntityId])
  @@index([userId, bookId])
  @@map("highlights")
}

// ── Offline reader synchronization ──────────────────────────────────────────

enum ReaderEntityKind {
  PROGRESS
  BOOKMARK
  ANNOTATION
}

enum ConflictReason {
  STALE_REVISION
  DELETE_VS_EDIT
}

/**
 * Permanent deduplication receipt keyed by `(subject, operationId)`. The stored
 * result is returned verbatim on replay; reusing the id with a different payload
 * hash is rejected. No TTL: an operation may be replayed for as long as the
 * client could retry, so receipts are never expired by time.
 */
model ReaderOperationReceipt {
  id              String             @id @default(uuid())
  subject         String
  user            User               @relation(fields: [subject], references: [id], onDelete: Cascade)
  operationId     String
  payloadHash     String
  result          Json
  createdAt       DateTime           @default(now())

  @@unique([subject, operationId])
  @@index([subject, createdAt])
  @@map("reader_operation_receipts")
}

/**
 * Tombstone for a soft-deleted bookmark/annotation identity. Carries the
 * deletion revision so a delayed add/update/retry cannot resurrect the entity.
 */
model ReaderTombstone {
  id         String           @id @default(uuid())
  subject    String
  user       User             @relation(fields: [subject], references: [id], onDelete: Cascade)
  entityId   String
  kind       ReaderEntityKind
  revision   Int
  deletedAt  DateTime         @default(now())

  @@unique([subject, entityId])
  @@index([subject, kind])
  @@map("reader_tombstones")
}

/**
 * Durable, first-class conflict copy preserving an offline edit whose base
 * revision was stale, or an edit that raced a delete. `operationId` and
 * `sourceEntityId` preserve provenance; `revision` increments on retarget.
 */
model ConflictCopy {
  id             String           @id @default(uuid())
  subject        String
  user           User             @relation(fields: [subject], references: [id], onDelete: Cascade)
  operationId    String
  sourceEntityId String
  bookId         String
  book           Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  contentVersion Int
  page           Int
  text           String
  note           String?
  color          String?
  anchor         Json?
  revision       Int              @default(1)
  reason         ConflictReason
  createdAt      DateTime         @default(now())

  @@index([subject, bookId])
  @@index([sourceEntityId])
  @@map("conflict_copies")
}

// ── Book reader ─────────────────────────────────────────────────────────────

model BookPage {
  id        String   @id @default(uuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  index     Int
  assetKey  String
  textKey   String?
  mimeType  String?
  width     Int?
  height    Int?
  charCount Int?
  createdAt DateTime @default(now())

  @@unique([bookId, index])
  @@map("book_pages")
}

model BookTocEntry {
  id     String @id @default(uuid())
  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title  String
  page   Int
  depth  Int    @default(0)
  order  Int

  @@index([bookId, order])
  @@map("book_toc_entries")
}

model BookConversionJob {
  id        String    @id @default(uuid())
  bookId    String
  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  status    String    @default("PENDING")
  attempts  Int       @default(0)
  lockedAt  DateTime?
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, createdAt])
  @@map("book_conversion_jobs")
}

model ReadingSession {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId     String
  book       Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  pageViews  PageView[]

  @@index([userId, bookId])
  @@index([expiresAt])
  @@map("reading_sessions")
}

model PageView {
  id             String         @id @default(uuid())
  sessionId      String
  session        ReadingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId         String
  bookId         String
  book           Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  page           Int
  contentVersion Int
  viewedAt       DateTime       @default(now())

  @@index([bookId, viewedAt])
  @@index([userId, viewedAt])
  @@map("page_views")
}

// ── Feed ────────────────────────────────────────────────────────────────────

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AnnouncementCategory {
  EVENT
  UPDATE
  GENERAL
}

model Announcement {
  id            String               @id @default(uuid())
  title         String
  body          String
  status        AnnouncementStatus   @default(DRAFT)
  category      AnnouncementCategory @default(GENERAL)
  publishAt     DateTime?
  expiresAt     DateTime?
  publishedAt   DateTime?
  publishedById String?
  publishedBy   User?                @relation("AnnouncementPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?                @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?

  @@index([status, publishAt(sort: Desc)])
  @@index([expiresAt])
  @@map("announcements")
}

model VerseOfTheDay {
  id        String   @id @default(uuid())
  date      DateTime @unique
  text      String
  reference String
  version   String   @default("KJV")
  fetchedAt DateTime @default(now())

  @@index([date(sort: Desc)])
  @@map("verse_of_day")
}

// ── Notifications ──────────────────────────────────────────────────────────

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  GROUP_INVITE
  GROUP_UPDATE
  ANNOUNCEMENT
  SYSTEM
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  payload     Json?
  readAt      DateTime?
  createdById String?
  createdBy   User?            @relation("NotificationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

// ── Audit ───────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  targetType String?
  targetId   String?
  payload    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ── Progress: activity, rollup, goals, streaks ──────────────────────────────

enum ActivityType {
  BOOK_READ
  BIBLE_READ
  FEED_READ
  GROUP_POST
}

enum GoalKind {
  DAYS
  PAGES
}

/// Append-only activity log. Source of truth.
model ActivityEvent {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       ActivityType
  /// Calendar day in UTC+8, server-computed. Never client-supplied.
  dayKey     String
  /// Normalized pages contributed (0 for feed/group). Clamped server-side to [0, 1].
  pagesDelta Int          @default(0)
  createdAt  DateTime     @default(now())

  @@index([userId, dayKey, type])
  @@map("activity_events")
}

/// Replay-dedup receipt for operationId-carrying events. Insert failure (P2002)
/// means this operation was already applied; its pagesDelta is not added again.
model ActivityEventReceipt {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  operationId String
  createdAt   DateTime @default(now())

  @@unique([userId, operationId])
  @@map("activity_event_receipts")
}

/// Dedup gate: one row per (user, day, type). Insert failure (P2002) = type already counted.
model DailyActivityType {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayKey    String
  type      ActivityType
  createdAt DateTime     @default(now())

  @@unique([userId, dayKey, type])
  @@map("daily_activity_types")
}

/// Per-day rollup. Read path for streak + heatmap; rebuildable from ActivityEvent.
model DailyActivity {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayKey        String
  /// Distinct activity types touched that day (0..4). Heatmap intensity metric.
  activityCount Int      @default(0)
  /// Sum of pagesDelta for the day.
  pagesRead     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, dayKey])
  @@map("daily_activity")
}

model ReadingGoal {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year        Int
  targetKind  GoalKind @default(DAYS)
  targetValue Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, year])
  @@map("reading_goals")
}

/// Streak cache. Rebuildable from DailyActivity; safe to drop.
model UserStreak {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastActiveDayKey String?
  updatedAt       DateTime @updatedAt

  @@map("user_streaks")
}
